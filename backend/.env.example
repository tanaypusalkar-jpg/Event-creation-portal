# Copy this file to .env in the backend folder and replace the example values.
APP_ENV=development

# MySQL: database and user must already exist. URL-encode special characters in the password.
DATABASE_URL=mysql+pymysql://event_portal:CHANGE_ME@127.0.0.1:3306/event_portal

# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRE_MINUTES=20

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin account created by: uv run python -m app.seed_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
